# このファイルを .env にコピーして値を設定してください
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 役割ごとのモデル。省略した場合は右側のデフォルトが使われます
CLAUDE_MODEL_GENERATE=claude-sonnet-5       # 台本・スライドの生成/修正
CLAUDE_MODEL_EVALUATE=claude-haiku-5-5       # 評価・整合性チェック（入力が重いので安価なHaiku。甘いと感じたらsonnet-5へ）
CLAUDE_MODEL_EXTRACT=claude-haiku-5-5  # 機械的な作業（総合チェックの統合など）

# GEMINI_API_KEYを設定すると2つの用途で使われる:
#  1. スライド挿絵生成(任意。GENERATE_SLIDE_IMAGES=1と併用時のみ)
#  2. 総合エージェントのクロスチェック(自動。設定されていれば常に使う。
#     Claudeに加えてGeminiにも独立で整合性チェックさせ、両方が一致した
#     指摘だけを修正ループに反映する)
# 未設定の場合、1は挿絵なしでスキップ、2はClaude単独チェックにフォールバックする
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GENERATE_SLIDE_IMAGES=0
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
GEMINI_MODEL_EVALUATE=gemini-3.1-pro-preview   # 総合エージェントのクロスチェックに使うモデル
