# このファイルを .env にコピーして値を設定してください
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 役割ごとのモデル。省略した場合は右側のデフォルトが使われます
CLAUDE_MODEL_GENERATE=claude-sonnet-5       # 台本・スライドの生成/修正
CLAUDE_MODEL_EVALUATE=claude-opus-4-8       # 評価・整合性チェック（品質のゲート役）
CLAUDE_MODEL_EXTRACT=claude-haiku-4-5-20251001  # VOICEVOXテキストの機械的な抽出

# スライド挿絵生成(任意)。GENERATE_SLIDE_IMAGES=1 かつ GEMINI_API_KEY が
# 設定されている場合のみ有効。未設定なら挿絵なしでスライドを生成する
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GENERATE_SLIDE_IMAGES=0
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
